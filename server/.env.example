DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/fitness_tracker"
JWT_SECRET="replace-with-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"
MAX_FILE_SIZE_MB=25

# Optional
# TRUST_PROXY=1                      # proxies in front of the server (nginx = 1, Cloudflare Tunnel + nginx = 2)
# ALLOW_REGISTRATION=true            # "false" stops new sign-ups
# REQUIRE_EMAIL_VERIFICATION=false   # "true" makes new accounts confirm their email before uploading
# UPLOADS_PER_HOUR=30                # per account
# EMAIL_FROM="TrailTracker <noreply@your-verified-domain>"
# STRAVA_WEBHOOK_SUBSCRIPTION_ID=    # when set, webhook events from any other subscription are ignored
